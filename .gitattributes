# .gitattributes (Claude 제안 + Spring Initializr 기본값 병합, 2026-07-29)
* text=auto
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# git hook 스크립트는 sh 실행을 위해 개행을 LF로 고정
.githooks/** text eol=lf

# Spring Initializr 기본값
/gradlew text eol=lf
*.jar binary

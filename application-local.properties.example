# 로컬 개발용 설정 템플릿.
# 사용법: 이 파일을 같은 위치에 application-local.properties 로 복사하면 로컬(H2)로 바로 실행됩니다.
#   macOS/Linux/Git Bash : cp application-local.properties.example application-local.properties
#   Windows PowerShell    : Copy-Item application-local.properties.example application-local.properties
#   (application-local.properties 는 .gitignore 되어 커밋되지 않음)
# 팀과 동일한 시크릿/설정이 필요하면 팀 내부에 공유된 프로퍼티 파일의 값을 사용하세요.
#
# 로컬은 인메모리 H2를 쓴다: 매 실행마다 스키마를 새로 굽고 종료 시 폐기 → 공용 Neon을 건드리지 않음.
# 배포(Render)는 이 파일이 없어 환경변수 SPRING_DATASOURCE_URL/_USERNAME/_PASSWORD 로 Neon에 붙는다.
# MODE=PostgreSQL 로 H2가 Postgres를 최대한 흉내내지만 100%는 아니므로, 배포 전엔 Neon으로도 한 번 확인 권장.

spring.datasource.url=jdbc:h2:mem:pulse;MODE=PostgreSQL;DB_CLOSE_DELAY=-1
spring.datasource.username=sa
spring.datasource.password=

spring.jpa.hibernate.ddl-auto=create-drop

# JWT secret (필수). 소스에 폴백을 두지 않으므로 로컬에서도 반드시 지정해야 부팅됩니다.
# HS256 서명이라 최소 32바이트(256비트) 이상으로. 배포(Render)는 이 파일 대신 env JWT_SECRET를 씁니다.
jwt.secret=local-dev-only-jwt-secret-change-me-min-32-bytes

# 로컬 개발용 DB 설정 템플릿.
# 사용법: 이 파일을 같은 위치에 application-local.properties 로 복사하면 끝(값 수정 불필요).
#   (application-local.properties 는 .gitignore 되어 커밋되지 않음)
#
# 로컬은 인메모리 H2를 쓴다: 매 실행마다 스키마를 새로 굽고 종료 시 폐기 → 공용 Neon을 건드리지 않음.
# 배포(Render)는 이 파일이 없어 환경변수 SPRING_DATASOURCE_URL/_USERNAME/_PASSWORD 로 Neon에 붙는다.
# MODE=PostgreSQL 로 H2가 Postgres를 최대한 흉내내지만 100%는 아니므로, 배포 전엔 Neon으로도 한 번 확인 권장.

spring.datasource.url=jdbc:h2:mem:pulse;MODE=PostgreSQL;DB_CLOSE_DELAY=-1
spring.datasource.username=sa
spring.datasource.password=

spring.jpa.hibernate.ddl-auto=create-drop
